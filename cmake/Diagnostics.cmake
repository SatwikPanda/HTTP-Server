# Applied through core's usage requirements to production code and its consumers.
set(HTTP_SANITIZER "none" CACHE STRING "Diagnostic instrumentation: none, address, address-undefined, thread")
set_property(CACHE HTTP_SANITIZER PROPERTY STRINGS none address address-undefined thread)
add_library(project_diagnostics INTERFACE)
if(HTTP_SANITIZER STREQUAL "none")
    return()
endif()
if(MSVC)
    if(NOT HTTP_SANITIZER STREQUAL "address")
        message(FATAL_ERROR "MSVC supports HTTP_SANITIZER=address only")
    endif()
    target_compile_options(project_diagnostics INTERFACE /fsanitize=address /Zi)
    target_link_options(project_diagnostics INTERFACE /INCREMENTAL:NO /DEBUG)
elseif(UNIX AND CMAKE_CXX_COMPILER_ID MATCHES "GNU|Clang")
    if(HTTP_SANITIZER STREQUAL "address-undefined")
        set(sanitizers address,undefined)
    elseif(HTTP_SANITIZER MATCHES "^(address|thread)$")
        set(sanitizers "${HTTP_SANITIZER}")
    else()
        message(FATAL_ERROR "Unknown HTTP_SANITIZER=${HTTP_SANITIZER}")
    endif()
    target_compile_options(project_diagnostics INTERFACE "-fsanitize=${sanitizers}" -fno-omit-frame-pointer -g)
    target_link_options(project_diagnostics INTERFACE "-fsanitize=${sanitizers}")
else()
    message(FATAL_ERROR "This toolchain/platform has no supported HTTP_SANITIZER configuration")
endif()
