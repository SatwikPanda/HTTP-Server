function(add_project_test name)
    cmake_parse_arguments(TEST "" "TIMEOUT" "SOURCES;LINKS;LABELS" ${ARGN})
    if(TEST_UNPARSED_ARGUMENTS OR NOT TEST_SOURCES OR NOT TEST_LABELS)
        message(FATAL_ERROR "${name}: SOURCES and LABELS are required; unknown arguments are forbidden")
    endif()
    if(NOT TEST_TIMEOUT)
        set(TEST_TIMEOUT 30)
    endif()
    add_executable(${name} ${TEST_SOURCES})
    target_link_libraries(${name} PRIVATE ${TEST_LINKS})
    target_include_directories(${name} PRIVATE "${PROJECT_SOURCE_DIR}/tests")
    if(MSVC)
        target_compile_options(${name} PRIVATE /UNDEBUG)
    else()
        target_compile_options(${name} PRIVATE -UNDEBUG)
    endif()
    add_test(NAME ${name} COMMAND ${name})
    set_property(GLOBAL APPEND PROPERTY REGISTERED_RUNTIME_TESTS ${name})
    set_tests_properties(${name} PROPERTIES TIMEOUT ${TEST_TIMEOUT} LABELS "${TEST_LABELS}")
    if(NOT REQUIRE_ALL_MILESTONES)
        set_tests_properties(${name} PROPERTIES SKIP_RETURN_CODE 77)
    endif()
endfunction()

function(require_project_tests)
    foreach(name IN LISTS ARGN)
        if(NOT TEST ${name})
            message(FATAL_ERROR "Required acceptance test is missing: ${name}")
        endif()
        get_test_property(${name} LABELS labels)
        if(NOT labels)
            message(FATAL_ERROR "Required acceptance test has no labels: ${name}")
        endif()
    endforeach()
endfunction()
